{
  // Static-assets deployment for this Next.js `output: "export"` site.
  // The site has no server runtime — `npm run build` emits a fully static
  // `out/` folder, and this Worker just serves those files. Do NOT use
  // @opennextjs/cloudflare here: OpenNext is for server-rendered Next.js
  // (it expects `.next/standalone/...`), which a static export never
  // produces. Cloudflare deploy command should be `npx wrangler deploy`.
  "name": "renegonzalesweb",
  "compatibility_date": "2026-07-14",
  "assets": {
    "directory": "./out",
    // trailingSlash: true in next.config.ts -> directory-style URLs.
    "html_handling": "auto-trailing-slash",
    // Serve the exported 404 page for unmatched routes.
    "not_found_handling": "404-page"
  }
}
